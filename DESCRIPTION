Package: croissant
Version: 0.0.2
Title: Read, Write, and Validate Croissant Dataset Metadata
Date: 2026-11-11
Authors@R: c(
    person(given = "E.D.", family = "Gennatas", role = c("aut", "cre", "cph"),
        email = "gennatas@gmail.com", comment = c(ORCID = "0000-0001-9280-3609")),
    person("MLCommons Association", role = "cph",
